    "version": "0.2.0",
    "configurations": [
        {
            "name": "RMS.Test",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-test",
            "program": "dotnet",
            "args": [
                "test",
                "${workspaceFolder}/RMS.Test/RMS.Test.csproj",
                "--logger",
                "console;verbosity=detailed"
            ],
            "cwd": "${workspaceFolder}/RMS.Test",
            "console": "integratedTerminal",
            "stopAtEntry": false
        }
    ]
}