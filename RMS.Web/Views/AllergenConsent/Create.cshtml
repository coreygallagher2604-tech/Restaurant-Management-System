@model RMS.Web.Models.AllergenConsentViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/AllergenConsent/Index","Allergen Consents"),
    ("","Add Consent")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Add Allergen Consent</h3>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label class="form-label">Order</label>
            <select id="orderPicker" name="orderId" form="orderPickerForm" class="form-select"
                    onchange="document.getElementById('orderPickerForm').submit()">
                <option value="0">-- Select an Order --</option>
                @foreach (var o in Model.AvailableOrders)
                {
                    if (o.Id == Model.OrderId)
                    {
                        <option value="@o.Id" selected>
                            Order #@o.Id — T@(o.Table != null ? o.Table.TableNumber.ToString() : "—") (£@o.totalCost.ToString("F2"))
                        </option>
                    }
                    else
                    {
                        <option value="@o.Id">
                            Order #@o.Id — T@(o.Table != null ? o.Table.TableNumber.ToString() : "—") (£@o.totalCost.ToString("F2"))
                        </option>
                    }
                }
            </select>
            <input asp-for="OrderId" type="hidden" />
        </div>

        @* This is a separate GET form. Clicking Load Items sends orderId to the controller,
           which reloads the page with only that order's menu items shown below. *@
        <form id="orderPickerForm" method="get" asp-action="Create"></form>

        <div class="mb-3">
            <label asp-for="CustomerName" class="form-label"></label>
            <input asp-for="CustomerName" class="form-control" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CustomerEmail" class="form-label"></label>
            <input asp-for="CustomerEmail" class="form-control" />
            <span asp-validation-for="CustomerEmail" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="CustomerPhone" class="form-label"></label>
            <input asp-for="CustomerPhone" class="form-control" placeholder="e.g. 07712345678 or +447712345678" />
            <span asp-validation-for="CustomerPhone" class="text-danger"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="ConsentGiven" class="form-check-input" />
            <label asp-for="ConsentGiven" class="form-check-label"></label>
        </div>
        <span asp-validation-for="ConsentGiven" class="text-danger"></span>

        <div class="mt-3">
            <label class="form-label">Menu Items on this Order</label>
            <div class="border rounded p-3" style="max-height:250px; overflow-y:auto;">
                @if (Model.AvailableMenuItems.Count == 0)
                {
                    <p class="text-muted mb-0">Select an order above to see its items.</p>
                }
                else
                {
                    @foreach (var item in Model.AvailableMenuItems)
                    {
                        <div class="form-check">
                            <input type="checkbox" name="SelectedMenuItemIds" value="@item.Id"
                                   class="form-check-input" id="item_@item.Id"
                                   @(Model.SelectedMenuItemIds.Contains(item.Id) ? "checked" : "") />
                            <label class="form-check-label" for="item_@item.Id">
                                @item.Name <span class="text-muted">(@item.Type)</span>
                            </label>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
