@model IList<RMS.Web.Models.AllergenConsentViewModel>

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/AllergenConsent/Index","Allergen Consents"),
    ("","Order Consents")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">
            Allergen Consents &mdash; Order #@(Model.FirstOrDefault()?.OrderId)
        </h3>
        <a asp-action="Index" class="btn btn-sm btn-secondary">Back to All Consents</a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">No allergen consents recorded for this order.</p>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Email</th>
                    <th>Phone</th>
                    <th>Consent Given</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.CustomerName</td>
                        <td>@c.CustomerEmail</td>
                        <td>@c.CustomerPhone</td>
                        <td>
                            @if (c.ConsentGiven)
                            {
                                <span class="badge bg-success">Yes</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">No</span>
                            }
                        </td>
                        <td>@c.CreatedOn.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager"))
                            {
                                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="DeleteConfirm" asp-route-id="@c.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"
                                            onclick="return confirm('Delete this allergen consent record? This cannot be undone.')">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
