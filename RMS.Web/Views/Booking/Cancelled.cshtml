@model IList<RMS.Web.Models.BookingViewModel>

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Booking/Index","Bookings"),
    ("","Cancelled")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-secondary">Cancelled Bookings</h3>
        <a asp-action="Index" class="btn btn-sm btn-outline-primary">Back to Bookings</a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted mt-3">No cancelled bookings.</p>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Customer</th>
                    <th>Date &amp; Time</th>
                    <th>Guests</th>
                    <th>Table</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>
                            @b.CustomerName
                            @if (b.HasAllergen)
                            {
                                <span class="badge bg-warning text-dark ms-1">Allergy</span>
                            }
                        </td>
                        <td>@b.BookingDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td>@b.NumberOfGuests</td>
                        <td>@(b.TableNumber > 0 ? $"T{b.TableNumber}" : "—")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">View</a>
                            <form asp-action="DeleteConfirm" asp-route-id="@b.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Permanently delete this cancelled booking?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
