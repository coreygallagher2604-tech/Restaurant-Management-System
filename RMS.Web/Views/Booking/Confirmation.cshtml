@model RMS.Web.Models.BookingViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("","Booking Confirmation")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-success">Booking Confirmed</h3>
        <span class="badge bg-success fs-6">Booked</span>
    </div>

    <p class="text-muted mb-4">Your table has been reserved. Please arrive on time. If you need to cancel, call us directly.</p>

    <dl class="row">
        <dt class="col-4">Name</dt>
        <dd class="col-8">@Model.CustomerName</dd>

        <dt class="col-4">Phone</dt>
        <dd class="col-8">@Model.PhoneNumber</dd>

        <dt class="col-4">Email</dt>
        <dd class="col-8">@Model.Email</dd>

        <dt class="col-4">Date &amp; Time</dt>
        <dd class="col-8">@Model.BookingDateTime.ToString("dddd dd MMMM yyyy") at @Model.BookingDateTime.ToString("HH:mm")</dd>

        <dt class="col-4">Guests</dt>
        <dd class="col-8">@Model.NumberOfGuests</dd>

        @if (Model.HasAllergen)
        {
            <dt class="col-4">Allergen Note</dt>
            <dd class="col-8">
                @if (Model.AllergenConsentGiven)
                {
                    <span>Allergen noted — consent given. Our team will be in touch if needed.</span>
                }
                else
                {
                    <span class="text-warning fw-semibold">Allergen noted — please speak to a member of staff on arrival.</span>
                }
            </dd>
        }

        @if (!string.IsNullOrEmpty(Model.BookingComments))
        {
            <dt class="col-4">Comments</dt>
            <dd class="col-8">@Model.BookingComments</dd>
        }
    </dl>

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-primary">Back to Home</a>
    </div>
</div>
