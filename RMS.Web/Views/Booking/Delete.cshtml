@model RMS.Web.Models.BookingViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Booking/Index","Bookings"),
    ("","Delete Booking")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-danger">Delete Booking?</h3>
    </div>

    <p class="text-muted">Are you sure you want to delete this booking? This cannot be undone.</p>

    <dl class="row">
        <dt class="col-4">Customer</dt>
        <dd class="col-8">@Model.CustomerName</dd>

        <dt class="col-4">Date &amp; Time</dt>
        <dd class="col-8">@Model.BookingDateTime.ToString("dd MMM yyyy HH:mm")</dd>

        <dt class="col-4">Guests</dt>
        <dd class="col-8">@Model.NumberOfGuests</dd>
    </dl>

    <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post">
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
