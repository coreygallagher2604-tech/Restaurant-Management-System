@model RMS.Web.Models.BookingViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Booking/Index","Bookings"),
    ("/Booking/Details/" + Model.Id, Model.CustomerName),
    ("","Details")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Booking — @Model.CustomerName</h3>
        @if (Model.Status == "Active")
        {
            <span class="badge bg-success fs-6">Active</span>
        }
        else if (Model.Status == "Cancelled")
        {
            <span class="badge bg-secondary fs-6">Cancelled</span>
        }
        else
        {
            <span class="badge bg-primary fs-6">Booked</span>
        }
    </div>

    <dl class="row">
        <dt class="col-4">Customer</dt>
        <dd class="col-8">@Model.CustomerName</dd>

        <dt class="col-4">Phone</dt>
        <dd class="col-8">@Model.PhoneNumber</dd>

        <dt class="col-4">Email</dt>
        <dd class="col-8">@Model.Email</dd>

        <dt class="col-4">Date &amp; Time</dt>
        <dd class="col-8">@Model.BookingDateTime.ToString("dd MMM yyyy HH:mm")</dd>

        <dt class="col-4">Guests</dt>
        <dd class="col-8">@Model.NumberOfGuests</dd>

        @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
        {
            <dt class="col-4">Table</dt>
            <dd class="col-8">@(Model.TableNumber > 0 ? $"T{Model.TableNumber}" : "Not assigned")</dd>
        }

        <dt class="col-4">Allergen</dt>
        <dd class="col-8">@(Model.HasAllergen ? "Yes" : "No")</dd>

        <dt class="col-4">Consent Given</dt>
        <dd class="col-8">@(Model.AllergenConsentGiven ? "Yes" : "No")</dd>

        <dt class="col-4">Comments</dt>
        <dd class="col-8">@(string.IsNullOrEmpty(Model.BookingComments) ? "—" : Model.BookingComments)</dd>
    </dl>

    <div class="mt-4 d-flex gap-2">
        @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        }
        @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager"))
        {
            <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Delete this booking? This cannot be undone.')">Delete</button>
            </form>
        }
        <a asp-action="Index" class="btn btn-secondary">Back to Bookings</a>
    </div>
</div>
