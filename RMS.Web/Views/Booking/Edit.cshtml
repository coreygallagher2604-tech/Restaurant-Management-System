@model RMS.Web.Models.BookingViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Booking/Index","Bookings"),
    ("","Edit Booking")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Edit Booking</h3>
    </div>

    <form asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Id" type="hidden" />

        <div class="mb-3">
            <label asp-for="CustomerName" class="form-label"></label>
            <input asp-for="CustomerName" class="form-control" />
            <span asp-validation-for="CustomerName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label"></label>
            <input asp-for="PhoneNumber" class="form-control" />
            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Booking Date</label>
            <input type="date" name="bookingDatePart" class="form-control"
                   value="@Model.BookingDateTime.ToString("yyyy-MM-dd")" />
        </div>

        <div class="mb-3">
            <label class="form-label">Booking Time</label>
            <select name="bookingTimePart" class="form-select">
                @for (var t = TimeSpan.FromHours(12); t <= TimeSpan.FromHours(21); t = t.Add(TimeSpan.FromMinutes(15)))
                {
                    string timeValue = $"{t.Hours:D2}:{t.Minutes:D2}";
                    if (timeValue == Model.BookingDateTime.ToString("HH:mm"))
                    {
                        <option value="@timeValue" selected>@timeValue</option>
                    }
                    else
                    {
                        <option value="@timeValue">@timeValue</option>
                    }
                }
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="NumberOfGuests" class="form-label"></label>
            <input asp-for="NumberOfGuests" class="form-control" type="number" min="1" />
            <span asp-validation-for="NumberOfGuests" class="text-danger"></span>
        </div>

        @{
            var takenNums = ViewBag.TakenTableNumbers as System.Collections.Generic.HashSet<int>
                            ?? new System.Collections.Generic.HashSet<int>();
        }

        @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager"))
        {
            <div class="alert alert-warning py-2" role="alert">
                <strong>Table changes are restricted to managers and above.</strong> Removing a table will free it immediately if guests are seated. Adding a table above capacity will require confirmation.
            </div>

            <div class="mb-3">
                <label asp-for="TableNumber" class="form-label">Primary Table</label>
                <select asp-for="TableNumber" class="form-select" id="primaryTableSelect">
                    @foreach (var t in (IEnumerable<RMS.Data.Entities.Table>)ViewBag.Tables)
                    {
                        bool taken = takenNums.Contains(t.TableNumber);
                        <option value="@t.TableNumber">
                            T@(t.TableNumber) — seats @t.SeatingCapacity@(taken ? " (already booked)" : "")
                        </option>
                    }
                </select>
                <span asp-validation-for="TableNumber" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Additional Tables (for large parties)</label>
                <div style="max-height:180px;overflow-y:auto;border:1px solid #dee2e6;border-radius:.375rem;padding:.5rem;" id="additionalTablesList">
                    @foreach (var t in (IEnumerable<RMS.Data.Entities.Table>)ViewBag.Tables)
                    {
                        bool taken = takenNums.Contains(t.TableNumber);
                        <div class="form-check additional-table-item" data-table-number="@t.TableNumber">
                            <input class="form-check-input additional-table-checkbox" type="checkbox"
                                   name="additionalTableNumbers"
                                   value="@t.TableNumber"
                                   id="tbl_@t.TableNumber"
                                   @(Model.AdditionalTableNumbersList.Contains(t.TableNumber) ? "checked" : "")
                                   @(taken ? "disabled" : "") />
                            <label class="form-check-label @(taken ? "text-muted" : "")" for="tbl_@t.TableNumber">
                                T@(t.TableNumber) — seats @t.SeatingCapacity@(taken ? " (already booked)" : "")
                            </label>
                        </div>
                    }
                </div>
                <small class="text-muted">Tick extra tables to join. Combined capacity must cover the party size. Tables already booked for this time slot are disabled.</small>
            </div>
        }
        else
        {
            <input type="hidden" asp-for="TableNumber" />
            <input type="hidden" asp-for="AdditionalTableNumbers" />
            <div class="mb-3">
                <label class="form-label">Table Assignment</label>
                <p class="form-control-plaintext">
                    T@(Model.TableNumber)
                    @if (!string.IsNullOrWhiteSpace(Model.AdditionalTableNumbers))
                    {
                        foreach (var n in Model.AdditionalTableNumbers.Split(','))
                        {
                            <span class="ms-1">+ T@(n.Trim())</span>
                        }
                    }
                </p>
                <small class="text-muted">Table assignment can only be changed by a manager or above.</small>
            </div>
        }

        <div class="mb-3 form-check">
            <input asp-for="HasAllergen" class="form-check-input" />
            <label asp-for="HasAllergen" class="form-check-label"></label>
        </div>

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option value="Booked">Booked</option>
                <option value="Seated">Seated</option>
                <option value="Completed">Completed</option>
                <option value="Cancelled">Cancelled</option>
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="BookingComments" class="form-label"></label>
            <textarea asp-for="BookingComments" class="form-control" rows="3"></textarea>
            <span asp-validation-for="BookingComments" class="text-danger"></span>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        function syncPrimaryTable() {
            var primaryVal = document.getElementById('primaryTableSelect').value;
            document.querySelectorAll('.additional-table-item').forEach(function (item) {
                var tn = item.getAttribute('data-table-number');
                var cb = item.querySelector('.additional-table-checkbox');
                if (!cb) return;
                if (tn === primaryVal) {
                    cb.checked = false;
                    cb.disabled = true;
                    item.classList.add('text-muted');
                } else if (!cb.hasAttribute('data-originally-disabled')) {
                    cb.disabled = false;
                    item.classList.remove('text-muted');
                }
            });
        }
        // Mark server-side disabled checkboxes so JS doesn't re-enable them
        document.querySelectorAll('.additional-table-checkbox[disabled]').forEach(function (cb) {
            cb.setAttribute('data-originally-disabled', '1');
        });
        document.getElementById('primaryTableSelect').addEventListener('change', syncPrimaryTable);
        syncPrimaryTable();
    </script>
}
