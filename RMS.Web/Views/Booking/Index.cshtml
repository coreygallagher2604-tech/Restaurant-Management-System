@model IList<RMS.Web.Models.BookingViewModel>

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("","Bookings")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Bookings</h3>
        <div class="d-flex gap-2">
            @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager"))
            {
                <a asp-action="Cancelled" class="btn btn-sm btn-outline-secondary">Cancelled</a>
            }
            <a asp-action="CreateBooking" class="btn btn-sm btn-primary">
                <i class="bi bi-plus"></i> New Booking
            </a>
        </div>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Date &amp; Time</th>
                <th>Guests</th>
                @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
                {
                    <th>Table</th>
                }
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>
                        @b.CustomerName
                        @if (b.HasAllergen)
                        {
                            <span class="badge bg-warning text-dark ms-1">Allergy</span>
                        }
                    </td>
                    <td>@b.BookingDateTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@b.NumberOfGuests</td>
                    @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
                    {
                        <td>
                            @if (b.TableNumber > 0)
                            {
                                <span>T@(b.TableNumber)</span>
                                @if (!string.IsNullOrWhiteSpace(b.AdditionalTableNumbers))
                                {
                                    foreach (var n in b.AdditionalTableNumbers.Split(','))
                                    {
                                        <span class="ms-1">+ T@(n.Trim())</span>
                                    }
                                }
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>
                    }
                    <td>
                        @if (b.Status == "Seated")
                        {
                            <span class="badge bg-success">Seated</span>
                        }
                        else if (b.Status == "Completed")
                        {
                            <span class="badge bg-dark">Completed</span>
                        }
                        else
                        {
                            <span class="badge bg-primary">Booked</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@b.Id" class="btn btn-sm btn-outline-secondary">View</a>
                        @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
                        {
                            @if (b.Status == "Booked")
                            {
                                @if (b.BookingDateTime.Date == DateTime.Today)
                                {
                                    <form asp-action="SeatGuests" asp-route-id="@b.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-success">Seat Guests</button>
                                    </form>
                                }
                                <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                <form asp-action="CancelBooking" asp-route-id="@b.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Cancel</button>
                                </form>
                                <form asp-action="DeleteConfirm" asp-route-id="@b.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this booking? This cannot be undone.')">Delete</button>
                                </form>
                            }
                            else if (b.Status == "Seated")
                            {
                                <form asp-action="CloseBooking" asp-route-id="@b.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-primary">Close Booking</button>
                                </form>
                                <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
