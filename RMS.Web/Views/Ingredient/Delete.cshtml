@model RMS.Web.Models.IngredientViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Ingredient/Index","Ingredients"),
    ("","Delete Ingredient")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-danger">Delete Ingredient?</h3>
    </div>

    <p class="text-muted">Are you sure you want to delete this ingredient? This cannot be undone.</p>

    <dl class="row">
        <dt class="col-4">Name</dt>
        <dd class="col-8">@Model.Name</dd>

        <dt class="col-4">Allergen</dt>
        <dd class="col-8">@(Model.Allergen ? "Yes" : "No")</dd>

        <dt class="col-4">Allergen Info</dt>
        <dd class="col-8">@Model.AllergenInfo</dd>
    </dl>

    <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post">
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
