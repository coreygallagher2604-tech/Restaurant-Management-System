@model IList<RMS.Web.Models.IngredientViewModel>

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("","Ingredients")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Ingredients</h3>
        <a asp-action="Create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus"></i> Add Ingredient
        </a>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Allergen</th>
                <th>Allergen Info</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var i in Model)
            {
                <tr>
                    <td>@i.Name</td>
                    <td>
                        @if (i.Allergen)
                        {
                            <span class="badge bg-danger">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">No</span>
                        }
                    </td>
                    <td>@i.AllergenInfo</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@i.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                        <form asp-action="DeleteConfirm" asp-route-id="@i.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this ingredient? This cannot be undone.')">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
