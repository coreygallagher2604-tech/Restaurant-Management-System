@model MenuViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Menu/Menus","Menus"),
    ("","Details")
}) />

@{
    string bannerClass = "bg-banks-green";
}

<div class="card rounded shadow overflow-hidden">
    <div class="@bannerClass p-4">
        <div class="d-flex align-items-start justify-content-between">
            <div>
                <h2 class="fw-bold mb-1">@Model.Name</h2>
                <span class="badge bg-white text-dark me-1">@Model.Type</span>
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@Model.StatusDisplay</span>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Menus" class="btn btn-sm btn-light">Back</a>
                @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-light">Edit</a>
                    @if (!Model.IsActive)
                    {
                        <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger bg-white" onclick="return confirm('Delete this menu? This cannot be undone.')">Delete</button>
                        </form>
                    }
                }
            </div>
        </div>
        <p class="mt-3 mb-0 fs-5">@Model.Description</p>
    </div>

    @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
    {
        <div class="px-4 py-2 bg-light border-bottom d-flex gap-4">
            <small class="text-muted">Created: @Model.CreatedOnDisplay</small>
            <small class="text-muted">Items: @Model.MenuItemCount</small>
        </div>
    }

    <div class="p-4">
        @if (Model.MenuItems.Any())
        {
            <partial name="_MenuMenuItems" model="Model" />
        }
        else
        {
            <p class="text-muted">No menu items have been added to this menu yet.</p>
        }
    </div>
</div>

