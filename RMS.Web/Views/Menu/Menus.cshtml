@model MenuSearchViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("","Menus")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Menus</h3>
        @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
        {
            <a asp-action="Create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus"></i> Add Menu
            </a>
        }
    </div>

    @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
    {
        <!-- Search Form -->
        <partial name="_Search" model="@Model" />
    }

    <!-- Results -->
    <table class="table table-hover mt-3">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
                {
                    <th>Status</th>
                    <th>Items</th>
                }
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Menus)
            {
                <tr>
                    <td>@m.Name</td>
                    <td>@m.Type</td>
                    @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
                    {
                        <td>
                            <span class="badge @(m.IsActive ? "bg-success" : "bg-secondary")">
                                @(m.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>@m.MenuItems?.Count</td>
                    }
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@m.Id" class="btn btn-sm btn-outline-primary">View</a>
                        @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || User.IsInRole("staff"))
                        {
                            <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                            <a asp-action="Delete" asp-route-id="@m.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>


