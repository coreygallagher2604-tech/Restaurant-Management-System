@model MenuItemSearchViewModel

<form asp-controller="Menu" asp-action="MenuItems" method="GET" class="d-flex flex-row align-items-center">
    <input class="form-control me-2" asp-for="Query" placeholder="Search..">
    <button class="btn btn-sm btn-outline-success" type="submit">Search</button>
    <a asp-controller="Menu" asp-action="MenuItems" class="btn btn-sm btn-light ms-3">Clear</a>
</form>
