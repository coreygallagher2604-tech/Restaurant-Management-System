@model Menu

<h5 class="border-bottom pb-2">Menu Items</h5>

@if (Model.MenuItems == null || !Model.MenuItems.Any())
{
    <p class="text-muted">No menu items found.</p>
}
else
{
    <table class="table table-sm table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.MenuItems)
            {
                <tr>
                    <td>@item.Name</td>                    
                    <td>@item.Description</td>
                    <td>€@item.Price.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>
}