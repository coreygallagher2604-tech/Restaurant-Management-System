@model RMS.Web.Models.MenuViewModel

@if (Model == null || !Model.MenuItems.Any())
{
    <p class="text-muted">No menu items found.</p>
}
else
{
    var foodSections = new[] {
        ("Starter",  "Starters"),
        ("Main",     "Mains"),
        ("Dessert",  "Desserts"),
        ("Side",     "Sides")
    };
    var drinkSections = new[] {
        ("Cocktail",   "Cocktails"),
        ("Spirit",     "Spirits"),
        ("Hot Drink",  "Hot Drinks"),
        ("Soft Drink", "Soft Drinks"),
        ("Beer",       "Beers"),
        ("Wine",       "Wines")
    };

    bool isDrinksMenu = string.Equals(Model.Type, "Drinks", StringComparison.OrdinalIgnoreCase);
    var sections = isDrinksMenu ? drinkSections : foodSections;

    foreach (var (type, label) in sections)
    {
        var items = Model.MenuItems.Where(i => i.Type == type).ToList();
        if (!items.Any()) { continue; }

        <h5 class="fw-bold mt-4">@label</h5>
        <hr class="mt-0" />

        foreach (var item in items)
        {
            <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                    <span class="fw-semibold">@item.Name</span>
                    <p class="text-muted small mb-0">@item.Description</p>
                </div>
                <span class="ms-3 fw-semibold text-nowrap">€@item.Price.ToString("F2")</span>
            </div>
        }
    }
}
