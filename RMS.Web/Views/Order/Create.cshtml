@model RMS.Web.Models.OrderViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Order/Index","Orders"),
    ("","New Order")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">New Order</h3>
    </div>

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mt-3">
            <label asp-for="TableId" class="form-label"></label>
            <select asp-for="TableId" class="form-select">
                <option value="">-- No Table --</option>
                @foreach (var t in Model.AvailableTables)
                {
                    <option value="@t.Id">T@(t.TableNumber) (seats @t.SeatingCapacity)</option>
                }
            </select>
        </div>

        <div class="mt-3">
            <label class="form-label fw-semibold">Menu Items <span class="text-muted fw-normal small">(set quantity to 0 to omit)</span></label>
            @{
                var foodTypes = new[] { "Starter", "Main", "Dessert", "Side" };
                var foodTypeSet = new HashSet<string>(foodTypes);
            }
            <ul class="nav nav-tabs" id="menuTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#food-tab-pane" type="button" role="tab">Food</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#drinks-tab-pane" type="button" role="tab">Drinks</button>
                </li>
            </ul>
            <div class="tab-content border border-top-0 rounded-bottom" style="max-height:400px; overflow-y:auto;">
                <div class="tab-pane fade show active p-3" id="food-tab-pane" role="tabpanel">
                    @foreach (var group in Model.AvailableMenuItems.Where(i => foodTypeSet.Contains(i.Type)).GroupBy(i => i.Type).OrderBy(g => Array.IndexOf(foodTypes, g.Key)))
                    {
                        <h6 class="text-muted fw-semibold mt-2 mb-1">@group.Key</h6>
                        @foreach (var item in group)
                        {
                            var qty = Model.ItemQuantities.TryGetValue(item.Id, out var q) ? q : 0;
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <div class="flex-grow-1">
                                    <span>@item.Name</span>
                                    <span class="text-muted ms-2 small">£@item.Price.ToString("F2")</span>
                                </div>
                                <label class="text-muted small mb-0">Qty</label>
                                <input type="number" name="ItemQuantities[@item.Id]" value="@qty" min="0" max="20" class="form-control form-control-sm" style="width:70px" />
                            </div>
                        }
                    }
                </div>
                <div class="tab-pane fade p-3" id="drinks-tab-pane" role="tabpanel">
                    @foreach (var group in Model.AvailableMenuItems.Where(i => !foodTypeSet.Contains(i.Type)).GroupBy(i => i.Type))
                    {
                        <h6 class="text-muted fw-semibold mt-2 mb-1">@group.Key</h6>
                        @foreach (var item in group)
                        {
                            var qty = Model.ItemQuantities.TryGetValue(item.Id, out var q) ? q : 0;
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <div class="flex-grow-1">
                                    <span>@item.Name</span>
                                    <span class="text-muted ms-2 small">£@item.Price.ToString("F2")</span>
                                </div>
                                <label class="text-muted small mb-0">Qty</label>
                                <input type="number" name="ItemQuantities[@item.Id]" value="@qty" min="0" max="20" class="form-control form-control-sm" style="width:70px" />
                            </div>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Create Order</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
