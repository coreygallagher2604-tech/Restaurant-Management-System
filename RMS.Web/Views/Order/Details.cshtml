@model RMS.Web.Models.OrderViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Order/Index","Orders"),
    ("","Order Details")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Order #@Model.Id</h3>
        <span class="badge @Model.StatusBadgeClass fs-6">@Model.StatusDisplay</span>
    </div>

    <dl class="row">
        <dt class="col-4">Table</dt>
        <dd class="col-8">@(Model.TableId.HasValue ? $"T{Model.TableId}" : "No table assigned")</dd>

        <dt class="col-4">Created</dt>
        <dd class="col-8">@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</dd>

        <dt class="col-4">Total</dt>
        <dd class="col-8">£@Model.TotalCost.ToString("F2")</dd>
    </dl>

    @if (Model.NeedsAllergenConsent && !Model.IsCompleted && !Model.IsVoid)
    {
        <div class="alert alert-danger d-flex align-items-center justify-content-between" role="alert">
            <div>
                <strong>Allergen consent required.</strong>
                @Model.AllergyCountRequired consent form(s) required &mdash; @Model.AllergenConsentCount recorded.
                This order cannot be completed until all consents are on file.
            </div>
            <a asp-controller="AllergenConsent" asp-action="Create" asp-route-orderId="@Model.Id"
               class="btn btn-sm btn-danger ms-3">Add Consent</a>
        </div>
    }

    <h5 class="mt-3">Items</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Unit Price</th>
                <th>Qty</th>
                <th>Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var oi in Model.OrderItems)
            {
                <tr>
                    <td>@oi.MenuItem?.Name</td>
                    <td>@oi.MenuItem?.Type</td>
                    <td>£@oi.UnitPrice.ToString("F2")</td>
                    <td>@oi.Quantity</td>
                    <td>£@((oi.UnitPrice * oi.Quantity).ToString("F2"))</td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.IsCompleted && !Model.IsVoid)
    {
        <h5 class="mt-4">Course Tracking</h5>
        <div class="d-flex gap-2 mb-3">
            @{
                var courses = new[] { "NotStarted", "StartersServed", "MainsServed", "DessertsServed" };
                var labels = new[] { "Not Started", "Starters", "Mains", "Desserts" };
                int currentIndex = Array.IndexOf(courses, Model.CourseStatus);
            }
            @for (int i = 0; i < courses.Length; i++)
            {
                string badgeClass;
                if (i < currentIndex)
                {
                    badgeClass = "bg-success";
                }
                else if (i == currentIndex)
                {
                    badgeClass = "bg-primary";
                }
                else
                {
                    badgeClass = "bg-secondary";
                }
                <span class="badge @badgeClass fs-6">@labels[i]</span>
            }
        </div>

        @if (Model.CourseStatus != "DessertsServed")
        {
            <form asp-action="AdvanceCourse" asp-route-id="@Model.Id" method="post">
                <button type="submit" class="btn btn-sm btn-outline-primary">Advance to Next Course</button>
            </form>
        }
    }

    <div class="mt-4 d-flex gap-2">
        @if (!Model.IsCompleted && !Model.IsVoid)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Order</a>
            <a asp-action="MarkCompleted" asp-route-id="@Model.Id" class="btn btn-success">Mark Completed</a>
            @if (User.IsInRole("admin") || User.IsInRole("owner"))
            {
                <a asp-action="Void" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Void Order</a>
            }
        }
        @if (Model.IsCompleted)
        {
            <a asp-controller="Review" asp-action="Create" asp-route-orderId="@Model.Id" class="btn btn-outline-warning">Leave a Review</a>
        }
        <a asp-action="Index" class="btn btn-secondary">Back to Orders</a>
    </div>
</div>
