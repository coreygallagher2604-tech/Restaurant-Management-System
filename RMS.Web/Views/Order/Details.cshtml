@model RMS.Web.Models.OrderViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Order/Index","Orders"),
    ("","Order Details")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Order #@Model.Id</h3>
        <span class="badge @Model.StatusBadgeClass fs-6">@Model.StatusDisplay</span>
    </div>

    <dl class="row">
        <dt class="col-4">Table</dt>
        <dd class="col-8">@(Model.TableId.HasValue ? $"T{Model.TableId}" : "No table assigned")</dd>

        <dt class="col-4">Created</dt>
        <dd class="col-8">@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</dd>

        <dt class="col-4">Total</dt>
        <dd class="col-8">£@Model.TotalCost.ToString("F2")</dd>
    </dl>

    <h5 class="mt-3">Items</h5>
    <table class="table table-sm">
        <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.MenuItems)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Type</td>
                    <td>£@item.Price.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="mt-4 d-flex gap-2">
        @if (!Model.IsCompleted && !Model.IsVoid)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit Order</a>
            <a asp-action="MarkCompleted" asp-route-id="@Model.Id" class="btn btn-success">Mark Completed</a>
            @if (User.IsInRole("admin") || User.IsInRole("owner"))
            {
                <a asp-action="Void" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Void Order</a>
            }
        }
        <a asp-action="Index" class="btn btn-secondary">Back to Orders</a>
    </div>
</div>
