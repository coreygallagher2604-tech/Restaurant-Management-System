@model RMS.Web.Models.OrderViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Order/Index","Orders"),
    ("/Order/Details/" + Model.Id, "Order #" + Model.Id),
    ("","Edit")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Edit Order #@Model.Id</h3>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mt-3">
            <label asp-for="TableId" class="form-label">Table</label>
            <select asp-for="TableId" class="form-select">
                <option value="">-- No Table --</option>
                @foreach (var t in Model.AvailableTables)
                {
                    if (t.Id == Model.TableId)
                    {
                        <option value="@t.Id" selected>T@(t.TableNumber) (seats @t.SeatingCapacity)</option>
                    }
                    else
                    {
                        <option value="@t.Id">T@(t.TableNumber) (seats @t.SeatingCapacity)</option>
                    }
                }
            </select>
        </div>

        <div class="mt-3">
            <label class="form-label">Menu Items</label>
            <div class="border rounded p-3" style="max-height:350px; overflow-y:auto;">
                @foreach (var item in Model.AvailableMenuItems)
                {
                    <div class="form-check">
                        @if (Model.SelectedMenuItemIds.Contains(item.Id))
                        {
                            <input type="checkbox" name="SelectedMenuItemIds" value="@item.Id"
                                   class="form-check-input" id="item_@item.Id" checked />
                        }
                        else
                        {
                            <input type="checkbox" name="SelectedMenuItemIds" value="@item.Id"
                                   class="form-check-input" id="item_@item.Id" />
                        }
                        <label class="form-check-label" for="item_@item.Id">
                            @item.Name <span class="text-muted">(@item.Type — £@item.Price.ToString("F2"))</span>
                        </label>
                    </div>
                }
            </div>
        </div>

        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
