@model IList<RMS.Web.Models.OrderViewModel>

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("","Orders")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        @if (ViewBag.TableNumber != null)
        {
            <h3 class="text-primary">Active Orders — T@(ViewBag.TableNumber)</h3>
            <a asp-controller="Table" asp-action="Index" class="btn btn-sm btn-outline-secondary">Back to Tables</a>
        }
        else
        {
            <h3 class="text-primary">Orders</h3>
            <a asp-action="Create" class="btn btn-sm btn-primary">
                <i class="bi bi-plus"></i> New Order
            </a>
        }
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Order #</th>
                <th>Table</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model)
            {
                <tr>
                    <td>@o.Id</td>
                    <td>@(o.TableId.HasValue ? $"T{o.TableId}" : "—")</td>
                    <td>@o.OrderItems.Count</td>
                    <td>£@o.TotalCost.ToString("F2")</td>
                    <td>
                        <span class="badge @o.StatusBadgeClass">@o.StatusDisplay</span>
                    </td>
                    <td class="text-end">
                        <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">View</a>
                        @if (!o.IsCompleted && !o.IsVoid)
                        {
                            <a asp-action="MarkCompleted" asp-route-id="@o.Id" class="btn btn-sm btn-outline-success">Complete</a>
                            <a asp-action="Void" asp-route-id="@o.Id" class="btn btn-sm btn-outline-secondary">Void</a>
                        }
                        @if (o.IsVoid)
                        {
                            <form asp-action="RestoreConfirm" method="post" style="display:inline">
                                <input type="hidden" name="id" value="@o.Id" />
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning"
                                        onclick="return confirm('Restore this order?')">Restore</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
