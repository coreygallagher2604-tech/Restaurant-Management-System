@model RMS.Web.Models.OrderViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Order/Index","Orders"),
    ("/Order/Details/" + Model.Id,"Order #" + Model.Id),
    ("","Mark Completed")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Mark Order #@Model.Id as Completed?</h3>
    </div>

    <p class="text-muted">This will mark the order as completed. This cannot be undone.</p>

    <dl class="row">
        <dt class="col-4">Table</dt>
        <dd class="col-8">@(Model.TableId.HasValue ? $"T{Model.TableId}" : "No table assigned")</dd>

        <dt class="col-4">Items</dt>
        <dd class="col-8">@Model.OrderItems.Count item(s)</dd>

        <dt class="col-4">Total</dt>
        <dd class="col-8">£@Model.TotalCost.ToString("F2")</dd>
    </dl>

    <form asp-action="MarkCompletedConfirm" asp-route-id="@Model.Id" method="post">
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-success">Yes, Mark Completed</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
