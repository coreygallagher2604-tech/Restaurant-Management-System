@model RMS.Web.Models.ReviewViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Review/Index","Reviews"),
    ("","Delete Review")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-danger">Delete Review?</h3>
    </div>

    <p class="text-muted">Are you sure you want to delete this review? This cannot be undone.</p>

    <dl class="row">
        <dt class="col-4">Customer</dt>
        <dd class="col-8">@Model.CustomerName</dd>

        <dt class="col-4">Order #</dt>
        <dd class="col-8">#@Model.OrderId</dd>

        <dt class="col-4">Rating</dt>
        <dd class="col-8">
            @for (int i = 1; i <= 5; i++)
            {
                if (i <= Model.Stars)
                {
                    <i class="bi bi-star-fill text-warning"></i>
                }
                else
                {
                    <i class="bi bi-star text-secondary"></i>
                }
            }
        </dd>

        <dt class="col-4">Comment</dt>
        <dd class="col-8">@Model.Comment</dd>
    </dl>

    <form asp-action="DeleteConfirm" asp-route-id="@Model.Id" method="post">
        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
