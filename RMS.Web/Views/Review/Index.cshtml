@model IList<RMS.Web.Models.ReviewViewModel>

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("","Reviews")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Customer Reviews</h3>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">No reviews yet.</p>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Customer</th>
                    <th>Rating</th>
                    <th>Comment</th>
                    <th>Date</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td>#@r.OrderId</td>
                        <td>@r.CustomerName</td>
                        <td>
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= r.Stars)
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                                else
                                {
                                    <i class="bi bi-star text-secondary"></i>
                                }
                            }
                        </td>
                        <td>@r.Comment</td>
                        <td>@r.CreatedOn.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            @if (User.IsInRole("admin") || User.IsInRole("owner"))
                            {
                                <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
