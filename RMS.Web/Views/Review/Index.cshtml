@model IList<RMS.Web.Models.ReviewViewModel>

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("","Reviews")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">What Our Guests Say</h3>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted mt-3">No reviews yet — be the first to leave one after your visit.</p>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-1">
            @foreach (var r in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border" style="border-color: var(--banks-stone) !important;">
                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= r.Stars)
                                    {
                                        <i class="bi bi-star-fill" style="color: #c07b24;"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-star text-secondary"></i>
                                    }
                                }
                            </div>
                            <p class="card-text flex-grow-1 fst-italic text-muted">"@r.Comment"</p>
                            <div class="mt-3 d-flex justify-content-between align-items-end">
                                <div>
                                    <p class="fw-semibold mb-0">@r.CustomerName</p>
                                    <small class="text-muted">@r.CreatedOn.ToString("dd MMM yyyy")</small>
                                </div>
                                @if (User.IsInRole("admin") || User.IsInRole("owner"))
                                {
                                    <form asp-action="DeleteConfirm" asp-route-id="@r.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this review? This cannot be undone.')">Delete</button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
