@model RMS.Web.Models.TableViewModel

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("/Table/Index","Tables"),
    ("","Delete Table")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom mb-3">
        <h3 class="text-danger">Delete Table</h3>
    </div>

    <p class="text-muted">Are you sure you want to delete this table? This cannot be undone.</p>

    <dl class="row">
        <dt class="col-4">Table Number</dt>
        <dd class="col-8">T@(Model.TableNumber)</dd>

        <dt class="col-4">Seating Capacity</dt>
        <dd class="col-8">@Model.SeatingCapacity</dd>

        <dt class="col-4">Status</dt>
        <dd class="col-8">@Model.StatusDisplay</dd>
    </dl>

    <form asp-action="DeleteConfirm">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
