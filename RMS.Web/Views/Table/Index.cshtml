@model IList<RMS.Web.Models.TableViewModel>

<partial name="_BreadCrumbs" model=@(new [] {
    ("/","Home"),
    ("","Tables")
}) />

<div class="card rounded shadow p-4">
    <div class="border-bottom d-flex align-items-center justify-content-between mb-3">
        <h3 class="text-primary">Tables</h3>
        <a asp-action="Create" class="btn btn-sm btn-primary">
            <i class="bi bi-plus"></i> Add Table
        </a>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>Table</th>
                <th>Capacity</th>
                <th>Seated</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>T@(t.TableNumber)</td>
                    <td>@t.SeatingCapacity</td>
                    <td>@t.CustomersSeated</td>
                    <td>
                        @{
                            var badgeClass = !t.Active     ? "bg-secondary"        :
                                              t.OrderNeeded ? "bg-warning text-dark" :
                                              t.IsOccupied  ? "bg-danger"            :
                                              t.IsReserved  ? "bg-warning text-dark" :
                                                              "bg-success";
                        }
                        <span class="badge @badgeClass"
                              @(t.IsReserved && t.ReservedAt.HasValue
                                  ? $"title=\"Reserved at {t.ReservedAt.Value:HH:mm}\" data-bs-toggle=\"tooltip\""
                                  : "")>
                            @t.StatusDisplay
                            @if (t.IsReserved && t.ReservedAt.HasValue)
                            {
                                <span class="ms-1 fw-normal">@t.ReservedAt.Value.ToString("HH:mm")</span>
                            }
                        </span>
                    </td>
                    <td class="text-end">
                        @if (t.IsOccupied)
                        {
                            <a asp-controller="Order" asp-action="ByTable" asp-route-tableId="@t.Id" class="btn btn-sm btn-outline-info">Orders</a>
                        }
                        @if (!t.IsOccupied && t.Active)
                        {
                            @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager") || (!t.IsReserved && User.IsInRole("staff")))
                            {
                                <a asp-controller="Booking" asp-action="WalkIn" asp-route-tableNumber="@t.TableNumber" class="btn btn-sm btn-outline-success">Walk-in</a>
                            }
                        }
                        <a asp-action="SetOccupancy" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary">Occupancy</a>
                        <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        @if (User.IsInRole("admin") || User.IsInRole("owner") || User.IsInRole("manager"))
                        {
                            <form asp-action="DeleteConfirm" asp-route-id="@t.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this table? This cannot be undone.')">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
